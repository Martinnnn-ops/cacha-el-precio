# ——— Backend cacha-el-precio (Gateway ASP.NET Core) ———
# URL base que usa el navegador. En producción es el gateway sin sufijo: el
# contrato del BFF publica /productos y /catalogos en la raíz (ADR-021).
# Si se deja VACÍA, la capa de servicios responde con los datos de ejemplo y la
# aplicación funciona entera sin backend levantado.
VITE_API_BASE_URL=https://api.cacha-el-precio.com

# Versión que el Product Service recibe en la cabecera `Version`.
VITE_API_VERSION=1.0

# Destino del proxy de desarrollo (lo lee vite.config.js, no el navegador).
BACKEND_URL=http://localhost:8080

# ——— Inicio de sesión Google mediante AWS Cognito + PKCE ———
# Las credenciales de Google viven sólo en Cognito; nunca en variables VITE_.
VITE_COGNITO_CLIENT_ID=3ev76jdoin1ouc1grqfdi3laam
VITE_COGNITO_DOMAIN=https://us-east-1ji5w1jelx.auth.us-east-1.amazoncognito.com

# ——— Publicidad (Google AdSense) ———
# Id de editor. Ojo al prefijo: en public/ads.txt va como "pub-…" y aquí como
# "ca-pub-…". Es el mismo número; si no coinciden, la cuenta queda sin
# verificar y no avisa nadie (npm run humo lo comprueba).
VITE_ADSENSE_CLIENT=ca-pub-2105662597936673

# Id de cada bloque (data-ad-slot), del panel de AdSense. Mientras estén
# vacíos el hueco no se renderiza, así que se puede desplegar sin ellos.
VITE_ADSENSE_SLOT_PORTADA=8911906010
VITE_ADSENSE_SLOT_CIERRE=8934589765
# Rectángulo de la ficha de producto (columna del precio).
VITE_ADSENSE_SLOT_FICHA=7355231436
# Banner dentro de los listados (comparador y outfits).
VITE_ADSENSE_SLOT_LISTADO=7621508098
