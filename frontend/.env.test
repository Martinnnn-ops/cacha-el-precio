# Las pruebas de dominio corren contra los datos de ejemplo, no contra la red.
VITE_API_BASE_URL=
VITE_API_VERSION=1.0

# El id de editor SÍ va, los ids de bloque NO, y esa asimetría es deliberada:
# `AdSlot` solo pinta cuando tiene las dos cosas. Así, con este entorno se
# comprueba a la vez que un bloque con id explícito se renderiza con los
# atributos que AdSense espera, y que la portada —cuyos ids salen de estas
# variables vacías— no muestra ni un hueco. Los bloques de verdad se prueban
# en `.env.anuncios`.
VITE_ADSENSE_CLIENT=ca-pub-2105662597936673
VITE_ADSENSE_SLOT_PORTADA=
VITE_ADSENSE_SLOT_CIERRE=
VITE_ADSENSE_SLOT_FICHA=
VITE_ADSENSE_SLOT_LISTADO=
