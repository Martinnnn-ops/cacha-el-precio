<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CachaElPrecio.Gateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Administración de mensajería (T11). Mismas versiones que los otros servicios. -->
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.18" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.19" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gateway.Tests" />
  </ItemGroup>

</Project>
