# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# ─── Cognito ───────────────────────────────────────────────────────
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_ISSUER=

# Lo que el BFF necesita para validar el token. Estos valores los emite
# `tools/crear-cognito.sh` en cognito.env, que NO se versiona.
#   CLIENT_IDS_VALIDOS  los client id nuestros, SEPARADOS POR COMA.
#                       Son dos: el del frontend y el de `pruebas`. Cognito no
#                       manda `aud` en el access_token, asi que el equivalente
#                       del audience se valida contra esta lista.
COGNITO_CLIENT_IDS_VALIDOS=
COGNITO_SCRAPER_SCOPE=https://api.cachaelprecio.cl/ingesta

# Atajo: set -a && source cognito.env && set +a  las deja todas en el entorno.

# ─── Base de datos ─────────────────────────────────────────────────
# Con docker compose, los microservicios ven la base en el host `postgres`
# (el nombre del servicio), no en `localhost`. DB_HOST=localhost sirve para
# conectarte tú desde el computador, por ejemplo con DBeaver o psql.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cachaelprecio
DB_USER=cachaelprecio
# Sin esto el compose NO arranca, a propósito: es preferible que falle a que
# levante con una contraseña adivinable.
DB_PASSWORD=

# ─── Microservicios ────────────────────────────────────────────────
# El BFF es la puerta de entrada; el resto no se expone a internet.
GATEWAY_PORT=8080
# Rootless Docker no puede enlazar puertos menores a 1024. En desarrollo usa
# 8088/8443; en producción se pueden omitir para conservar 80/443.
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=8443
PRODUCT_PORT=8081
# A donde consulta el BFF. Dentro del compose es el nombre del servicio.
PRODUCT_URL=http://localhost:8081

# ─── Scraper Python (FastAPI) ─────────────────────────────────────
SCRAPER_API_PORT=8000
APP_ENV=production
# URL base del Product Service. Dentro del compose es el host del servicio;
# para correr el scraper fuera de Docker, apuntar al puerto expuesto.
PRODUCT_SERVICE_URL=http://product-service:8081
# Listados públicos de Falabella separados por coma. Cada página expone
# hasta 60 productos; el scraper recorre tres páginas por categoría.
FALABELLA_LISTING_CATEGORIES=https://www.falabella.com/falabella-cl/category/cat1320010/Poleras-Hombre,https://www.falabella.com/falabella-cl/category/cat850068/Zapatillas-Mujer
FALABELLA_LISTING_PAGES=3

# ─── AWS ───────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_CRUDO=

# ─── El encabezado del borde ───────────────────────────────────────
# Caddy exige este valor en el puerto 8080 y responde 403 a quien no lo traiga.
# Lo genera tools/crear-api-gateway.sh en borde.env, y tools/desplegar.sh lo
# copia al .env del servidor: no hay que escribirlo a mano.
#
# Si se deja vacio en la maquina, el Caddyfile responde 403 a TODO por su valor
# por defecto. Es a proposito: un fallo de configuracion tiene que romper hacia
# el lado seguro, no abrir la puerta.
BORDE_SECRETO=

# ─── Frontend (Vite) ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173/callback
