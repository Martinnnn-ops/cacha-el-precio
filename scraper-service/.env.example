# ============================================================
# APPLICATION
# ============================================================

APP_NAME=cacha-el-precio-scrapper
APP_ENV=development
LOG_LEVEL=INFO


# ============================================================
# DATABASE - PostgreSQL
# ============================================================

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/cacha_el_precio


# ============================================================
# HTTP CLIENT / SCRAPING
# ============================================================

HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=CachaElPrecioBot/1.0 (+tu-correo@ejemplo.cl)


# ============================================================
# IMAGE PROCESSING
# ============================================================

IMAGE_MAX_WIDTH=800
IMAGE_MAX_HEIGHT=800
IMAGE_CARD_SIZE=400
IMAGE_MAX_DOWNLOAD_BYTES=8388608
IMAGE_MAX_PIXELS=40000000
IMAGE_WEBP_QUALITY=82


# ============================================================
# STORAGE - S3
# ============================================================

AWS_REGION=us-east-1
AWS_S3_BUCKET=product-images-988704560705-us-east-1-an
AWS_S3_PUBLIC_BASE_URL=https://product-images-988704560705-us-east-1-an.s3.us-east-1.amazonaws.com

# Solo necesario si NO utilizas IAM Role. Descomenta las tres juntas.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# Credencial temporal de AWS Academy. En EC2 boto3 usa el rol de la
# instancia y estas tres variables no son necesarias.
# AWS_SESSION_TOKEN=your_session_token


# ============================================================
# SCRAPER
# ============================================================

SCRAPER_REQUEST_DELAY=1.0
SCRAPER_MAX_CONCURRENT_REQUESTS=5


# ============================================================
# CONVERSE
# ============================================================

CONVERSE_BASE_URL=https://example.com
