    {
      "type": "stat",
      "title": "Servicios arriba",
      "description": "Cuántos de los 3 servicios .NET le responden a Prometheus (up = 1).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{job=\"servicios\"})",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "max": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
