    {
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "description": "Todas las peticiones que recibe cada servicio .NET.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (servicio) (rate(http_requests_received_total[$__rate_interval]))",
          "legendFormat": "{{servicio}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
